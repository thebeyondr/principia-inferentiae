{
  "$defs": {
    "AnalysisStatus": {
      "enum": [
        "supported",
        "insufficient_evidence",
        "inconclusive",
        "memory_not_fit",
        "slo_not_met",
        "quality_gate_failed"
      ],
      "title": "AnalysisStatus",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "minLength": 1,
          "title": "Claim Type",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "contrary_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contrary Evidence Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "missing_telemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missing Telemetry",
          "type": "array"
        },
        "next_discriminating_experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Discriminating Experiment"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        },
        "supporting_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/UnitRecord"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "claim_type",
        "statement",
        "status",
        "evidence_ids",
        "method_id",
        "units",
        "assumptions",
        "limitations",
        "confidence",
        "missing_telemetry",
        "next_discriminating_experiment"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Diagnosis": {
      "additionalProperties": false,
      "properties": {
        "missing_telemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missing Telemetry",
          "type": "array"
        },
        "next_discriminating_experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Discriminating Experiment"
        },
        "ranked_hypotheses": {
          "items": {
            "$ref": "#/$defs/RankedHypothesis"
          },
          "title": "Ranked Hypotheses",
          "type": "array"
        },
        "root_cause_hypothesis_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Root Cause Hypothesis Id"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        }
      },
      "required": [
        "status",
        "root_cause_hypothesis_id",
        "ranked_hypotheses",
        "missing_telemetry",
        "next_discriminating_experiment"
      ],
      "title": "Diagnosis",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "input",
        "synthetic_fixture",
        "direct_event",
        "measured_metric",
        "correlation",
        "configuration",
        "intervention",
        "artifact",
        "estimate"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "event_type": {
          "anyOf": [
            {
              "enum": [
                "oom",
                "preemption"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_value": {
          "title": "Observed Value",
          "type": "string"
        },
        "source_digest": {
          "$ref": "#/$defs/Digest"
        },
        "timestamp_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Ms"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "description",
        "observed_value",
        "unit",
        "source_digest"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "RankedHypothesis": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "causal_gate_passed": {
          "title": "Causal Gate Passed",
          "type": "boolean"
        },
        "contrary_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contrary Evidence Ids",
          "type": "array"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "status": {
          "enum": [
            "confirmed",
            "correlated",
            "inconclusive",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "category",
        "score",
        "status",
        "supporting_evidence_ids",
        "contrary_evidence_ids",
        "causal_gate_passed"
      ],
      "title": "RankedHypothesis",
      "type": "object"
    },
    "RunMetadata": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "code_revision": {
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        },
        "input_digests": {
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "title": "Input Digests",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method_revision": {
          "minLength": 1,
          "title": "Method Revision",
          "type": "string"
        },
        "package_version": {
          "minLength": 1,
          "title": "Package Version",
          "type": "string"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "reproducibility_tier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ],
          "title": "Reproducibility Tier",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "created_at_utc",
        "package_version",
        "code_revision",
        "reproducibility_tier",
        "method_revision",
        "random_seed",
        "input_digests"
      ],
      "title": "RunMetadata",
      "type": "object"
    },
    "UnitRecord": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "field",
        "unit"
      ],
      "title": "UnitRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "diagnosis": {
      "$ref": "#/$defs/Diagnosis"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/RunMetadata"
    }
  },
  "required": [
    "run",
    "evidence",
    "claims",
    "diagnosis"
  ],
  "title": "DiagnosisAnalysis",
  "type": "object"
}
