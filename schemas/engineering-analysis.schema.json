{
  "$defs": {
    "AnalysisStatus": {
      "enum": [
        "supported",
        "insufficient_evidence",
        "inconclusive",
        "memory_not_fit",
        "slo_not_met",
        "quality_gate_failed"
      ],
      "title": "AnalysisStatus",
      "type": "string"
    },
    "BenchmarkPlan": {
      "additionalProperties": false,
      "properties": {
        "command_template": {
          "title": "Command Template",
          "type": "string"
        },
        "equivalence_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Equivalence Requirements",
          "type": "array"
        },
        "load_points_rps": {
          "items": {
            "type": "number"
          },
          "title": "Load Points Rps",
          "type": "array"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "required_config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Required Config Hash",
          "type": "string"
        },
        "required_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Required Metrics",
          "type": "array"
        },
        "required_workload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Required Workload Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "required",
            "not_required"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "status",
        "required_workload_hash",
        "required_config_hash",
        "required_metrics",
        "load_points_rps",
        "command_template",
        "equivalence_requirements"
      ],
      "title": "BenchmarkPlan",
      "type": "object"
    },
    "BoundClassification": {
      "enum": [
        "compute_bound",
        "hbm_bandwidth_bound",
        "underfilled",
        "mixed",
        "insufficient_evidence"
      ],
      "title": "BoundClassification",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "minLength": 1,
          "title": "Claim Type",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "contrary_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contrary Evidence Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "missing_telemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missing Telemetry",
          "type": "array"
        },
        "next_discriminating_experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Discriminating Experiment"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        },
        "supporting_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/UnitRecord"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "claim_type",
        "statement",
        "status",
        "evidence_ids",
        "method_id",
        "units",
        "assumptions",
        "limitations",
        "confidence",
        "missing_telemetry",
        "next_discriminating_experiment"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DeploymentRecommendation": {
      "additionalProperties": false,
      "properties": {
        "active_replicas": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Replicas"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "gpus_per_replica": {
          "title": "Gpus Per Replica",
          "type": "integer"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "matched_service_curve_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matched Service Curve Id"
        },
        "max_slo_goodput_rps_per_replica": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Slo Goodput Rps Per Replica"
        },
        "memory_fit_lower_bound_gpus": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Fit Lower Bound Gpus"
        },
        "quality_gate_evaluation_id": {
          "title": "Quality Gate Evaluation Id",
          "type": "string"
        },
        "recommended_gpu_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommended Gpu Count"
        },
        "required_peak_rps_with_headroom": {
          "title": "Required Peak Rps With Headroom",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        },
        "total_replicas_with_reserve": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Replicas With Reserve"
        }
      },
      "required": [
        "status",
        "memory_fit_lower_bound_gpus",
        "recommended_gpu_count",
        "active_replicas",
        "total_replicas_with_reserve",
        "gpus_per_replica",
        "matched_service_curve_id",
        "max_slo_goodput_rps_per_replica",
        "required_peak_rps_with_headroom",
        "quality_gate_evaluation_id",
        "assumptions",
        "limitations"
      ],
      "title": "DeploymentRecommendation",
      "type": "object"
    },
    "Diagnosis": {
      "additionalProperties": false,
      "properties": {
        "missing_telemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missing Telemetry",
          "type": "array"
        },
        "next_discriminating_experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Discriminating Experiment"
        },
        "ranked_hypotheses": {
          "items": {
            "$ref": "#/$defs/RankedHypothesis"
          },
          "title": "Ranked Hypotheses",
          "type": "array"
        },
        "root_cause_hypothesis_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Root Cause Hypothesis Id"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        }
      },
      "required": [
        "status",
        "root_cause_hypothesis_id",
        "ranked_hypotheses",
        "missing_telemetry",
        "next_discriminating_experiment"
      ],
      "title": "Diagnosis",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "input",
        "synthetic_fixture",
        "direct_event",
        "measured_metric",
        "correlation",
        "configuration",
        "intervention",
        "artifact",
        "estimate"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "event_type": {
          "anyOf": [
            {
              "enum": [
                "oom",
                "preemption"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_value": {
          "title": "Observed Value",
          "type": "string"
        },
        "source_digest": {
          "$ref": "#/$defs/Digest"
        },
        "timestamp_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Ms"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "description",
        "observed_value",
        "unit",
        "source_digest"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "MemoryEstimate": {
      "additionalProperties": false,
      "properties": {
        "active_tokens_configured": {
          "title": "Active Tokens Configured",
          "type": "integer"
        },
        "aggregate_capacity_lower_bound_gpus": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aggregate Capacity Lower Bound Gpus"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "fits_per_rank": {
          "title": "Fits Per Rank",
          "type": "boolean"
        },
        "fragmentation_reserve_per_rank_bytes": {
          "title": "Fragmentation Reserve Per Rank Bytes",
          "type": "integer"
        },
        "hardware_digest": {
          "$ref": "#/$defs/Digest"
        },
        "headroom_per_rank_bytes": {
          "title": "Headroom Per Rank Bytes",
          "type": "integer"
        },
        "kv_bytes_per_token_logical": {
          "title": "Kv Bytes Per Token Logical",
          "type": "integer"
        },
        "kv_bytes_per_token_per_rank": {
          "title": "Kv Bytes Per Token Per Rank",
          "type": "integer"
        },
        "kv_cache_per_rank_bytes": {
          "title": "Kv Cache Per Rank Bytes",
          "type": "integer"
        },
        "model_digest": {
          "$ref": "#/$defs/Digest"
        },
        "quantization_metadata_total_bytes": {
          "title": "Quantization Metadata Total Bytes",
          "type": "integer"
        },
        "required_per_rank_bytes": {
          "title": "Required Per Rank Bytes",
          "type": "integer"
        },
        "runtime_reserve_per_rank_bytes": {
          "title": "Runtime Reserve Per Rank Bytes",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        },
        "usable_device_bytes": {
          "title": "Usable Device Bytes",
          "type": "integer"
        },
        "weights_per_rank_bytes": {
          "title": "Weights Per Rank Bytes",
          "type": "integer"
        },
        "weights_total_bytes": {
          "title": "Weights Total Bytes",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "weights_total_bytes",
        "quantization_metadata_total_bytes",
        "weights_per_rank_bytes",
        "kv_bytes_per_token_logical",
        "kv_bytes_per_token_per_rank",
        "active_tokens_configured",
        "kv_cache_per_rank_bytes",
        "runtime_reserve_per_rank_bytes",
        "fragmentation_reserve_per_rank_bytes",
        "required_per_rank_bytes",
        "usable_device_bytes",
        "headroom_per_rank_bytes",
        "fits_per_rank",
        "aggregate_capacity_lower_bound_gpus",
        "model_digest",
        "hardware_digest",
        "config_hash",
        "assumptions"
      ],
      "title": "MemoryEstimate",
      "type": "object"
    },
    "Percentiles": {
      "additionalProperties": false,
      "properties": {
        "p50": {
          "minimum": 0,
          "title": "P50",
          "type": "number"
        },
        "p95": {
          "minimum": 0,
          "title": "P95",
          "type": "number"
        },
        "p99": {
          "minimum": 0,
          "title": "P99",
          "type": "number"
        }
      },
      "required": [
        "p50",
        "p95",
        "p99"
      ],
      "title": "Percentiles",
      "type": "object"
    },
    "RankedHypothesis": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "causal_gate_passed": {
          "title": "Causal Gate Passed",
          "type": "boolean"
        },
        "contrary_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contrary Evidence Ids",
          "type": "array"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "status": {
          "enum": [
            "confirmed",
            "correlated",
            "inconclusive",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "category",
        "score",
        "status",
        "supporting_evidence_ids",
        "contrary_evidence_ids",
        "causal_gate_passed"
      ],
      "title": "RankedHypothesis",
      "type": "object"
    },
    "RooflineMetrics": {
      "additionalProperties": false,
      "properties": {
        "achieved_hbm_bandwidth_gbps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Achieved Hbm Bandwidth Gbps"
        },
        "achieved_tflops": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Achieved Tflops"
        },
        "arithmetic_intensity_flops_per_byte": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Arithmetic Intensity Flops Per Byte"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "capacity_pressure_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capacity Pressure Fraction"
        },
        "classification": {
          "$ref": "#/$defs/BoundClassification"
        },
        "machine_balance_flops_per_byte": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Machine Balance Flops Per Byte"
        },
        "roofline_ceiling_tflops": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Roofline Ceiling Tflops"
        },
        "roofline_efficiency_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Roofline Efficiency Fraction"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        }
      },
      "required": [
        "status",
        "classification",
        "arithmetic_intensity_flops_per_byte",
        "machine_balance_flops_per_byte",
        "achieved_tflops",
        "roofline_ceiling_tflops",
        "roofline_efficiency_fraction",
        "achieved_hbm_bandwidth_gbps",
        "capacity_pressure_fraction",
        "assumptions"
      ],
      "title": "RooflineMetrics",
      "type": "object"
    },
    "RunMetadata": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "code_revision": {
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        },
        "input_digests": {
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "title": "Input Digests",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method_revision": {
          "minLength": 1,
          "title": "Method Revision",
          "type": "string"
        },
        "package_version": {
          "minLength": 1,
          "title": "Package Version",
          "type": "string"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "reproducibility_tier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ],
          "title": "Reproducibility Tier",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "created_at_utc",
        "package_version",
        "code_revision",
        "reproducibility_tier",
        "method_revision",
        "random_seed",
        "input_digests"
      ],
      "title": "RunMetadata",
      "type": "object"
    },
    "SLOSpec": {
      "additionalProperties": false,
      "properties": {
        "max_e2e_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max E2E Ms P99"
        },
        "max_itl_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Itl Ms P99"
        },
        "max_tpot_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tpot Ms P99"
        },
        "max_ttft_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Ttft Ms P99"
        },
        "metric_scope": {
          "enum": [
            "inference_only",
            "end_to_end"
          ],
          "title": "Metric Scope",
          "type": "string"
        },
        "min_aggregate_tps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Aggregate Tps"
        },
        "min_goodput_fraction": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Goodput Fraction",
          "type": "number"
        },
        "min_per_user_tps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Per User Tps"
        },
        "queue_boundary": {
          "title": "Queue Boundary",
          "type": "string"
        }
      },
      "required": [
        "min_goodput_fraction",
        "metric_scope",
        "queue_boundary"
      ],
      "title": "SLOSpec",
      "type": "object"
    },
    "UnitRecord": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "field",
        "unit"
      ],
      "title": "UnitRecord",
      "type": "object"
    },
    "WorkloadProfile": {
      "additionalProperties": false,
      "properties": {
        "burstiness_peak_to_mean": {
          "minimum": 1,
          "title": "Burstiness Peak To Mean",
          "type": "number"
        },
        "mean_arrival_rps": {
          "minimum": 0,
          "title": "Mean Arrival Rps",
          "type": "number"
        },
        "missing_telemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missing Telemetry",
          "type": "array"
        },
        "observation_window_ms": {
