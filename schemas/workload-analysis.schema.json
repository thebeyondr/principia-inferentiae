{
  "$defs": {
    "AnalysisStatus": {
      "enum": [
        "supported",
        "insufficient_evidence",
        "inconclusive",
        "memory_not_fit",
        "slo_not_met",
        "quality_gate_failed"
      ],
      "title": "AnalysisStatus",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "minLength": 1,
          "title": "Claim Type",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "contrary_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contrary Evidence Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "missing_telemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missing Telemetry",
          "type": "array"
        },
        "next_discriminating_experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Discriminating Experiment"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AnalysisStatus"
        },
        "supporting_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/UnitRecord"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "claim_type",
        "statement",
        "status",
        "evidence_ids",
        "method_id",
        "units",
        "assumptions",
        "limitations",
        "confidence",
        "missing_telemetry",
        "next_discriminating_experiment"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "input",
        "synthetic_fixture",
        "direct_event",
        "measured_metric",
        "correlation",
        "configuration",
        "intervention",
        "artifact",
        "estimate"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "event_type": {
          "anyOf": [
            {
              "enum": [
                "oom",
                "preemption"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_value": {
          "title": "Observed Value",
          "type": "string"
        },
        "source_digest": {
          "$ref": "#/$defs/Digest"
        },
        "timestamp_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Ms"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "description",
        "observed_value",
        "unit",
        "source_digest"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "Percentiles": {
      "additionalProperties": false,
      "properties": {
        "p50": {
          "minimum": 0,
          "title": "P50",
          "type": "number"
        },
        "p95": {
          "minimum": 0,
          "title": "P95",
          "type": "number"
        },
        "p99": {
          "minimum": 0,
          "title": "P99",
          "type": "number"
        }
      },
      "required": [
        "p50",
        "p95",
        "p99"
      ],
      "title": "Percentiles",
      "type": "object"
    },
    "RunMetadata": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "code_revision": {
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        },
        "input_digests": {
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "title": "Input Digests",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method_revision": {
          "minLength": 1,
          "title": "Method Revision",
          "type": "string"
        },
        "package_version": {
          "minLength": 1,
          "title": "Package Version",
          "type": "string"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "reproducibility_tier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ],
          "title": "Reproducibility Tier",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "created_at_utc",
        "package_version",
        "code_revision",
        "reproducibility_tier",
        "method_revision",
        "random_seed",
        "input_digests"
      ],
      "title": "RunMetadata",
      "type": "object"
    },
    "SLOSpec": {
      "additionalProperties": false,
      "properties": {
        "max_e2e_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max E2E Ms P99"
        },
        "max_itl_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Itl Ms P99"
        },
        "max_tpot_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tpot Ms P99"
        },
        "max_ttft_ms_p99": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Ttft Ms P99"
        },
        "metric_scope": {
          "enum": [
            "inference_only",
            "end_to_end"
          ],
          "title": "Metric Scope",
          "type": "string"
        },
        "min_aggregate_tps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Aggregate Tps"
        },
        "min_goodput_fraction": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Goodput Fraction",
          "type": "number"
        },
        "min_per_user_tps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Per User Tps"
        },
        "queue_boundary": {
          "title": "Queue Boundary",
          "type": "string"
        }
      },
      "required": [
        "min_goodput_fraction",
        "metric_scope",
        "queue_boundary"
      ],
      "title": "SLOSpec",
      "type": "object"
    },
    "UnitRecord": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "field",
        "unit"
      ],
      "title": "UnitRecord",
      "type": "object"
    },
    "WorkloadProfile": {
      "additionalProperties": false,
      "properties": {
        "burstiness_peak_to_mean": {
          "minimum": 1,
          "title": "Burstiness Peak To Mean",
          "type": "number"
        },
        "mean_arrival_rps": {
          "minimum": 0,
          "title": "Mean Arrival Rps",
          "type": "number"
        },
        "missing_telemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missing Telemetry",
          "type": "array"
        },
        "observation_window_ms": {
          "exclusiveMinimum": 0,
          "title": "Observation Window Ms",
          "type": "integer"
        },
        "output_tokens": {
          "$ref": "#/$defs/Percentiles"
        },
        "peak_observed_concurrency": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Observed Concurrency"
        },
        "peak_one_second_arrival_rps": {
          "minimum": 0,
          "title": "Peak One Second Arrival Rps",
          "type": "number"
        },
        "prefix_reuse_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prefix Reuse Fraction",
          "type": "number"
        },
        "prompt_tokens": {
          "$ref": "#/$defs/Percentiles"
        },
        "request_count": {
          "exclusiveMinimum": 0,
          "title": "Request Count",
          "type": "integer"
        },
        "shared_prefix_tokens": {
          "$ref": "#/$defs/Percentiles"
        },
        "slo": {
          "$ref": "#/$defs/SLOSpec"
        },
        "tenant_count": {
          "exclusiveMinimum": 0,
          "title": "Tenant Count",
          "type": "integer"
        },
        "total_tokens": {
          "$ref": "#/$defs/Percentiles"
        },
        "trace_digest": {
          "$ref": "#/$defs/Digest"
        },
        "workload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workload Hash",
          "type": "string"
        }
      },
      "required": [
        "workload_hash",
        "trace_digest",
        "request_count",
        "observation_window_ms",
        "prompt_tokens",
        "output_tokens",
        "total_tokens",
        "mean_arrival_rps",
        "peak_one_second_arrival_rps",
        "burstiness_peak_to_mean",
        "prefix_reuse_fraction",
        "shared_prefix_tokens",
        "tenant_count",
        "slo",
        "missing_telemetry"
      ],
      "title": "WorkloadProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/WorkloadProfile"
    },
    "run": {
      "$ref": "#/$defs/RunMetadata"
    }
  },
  "required": [
    "run",
    "evidence",
    "claims",
    "profile"
  ],
  "title": "WorkloadAnalysis",
  "type": "object"
}
